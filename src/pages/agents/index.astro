---
/**
 * AI Agent Directory index. Structurally identical to /tools — same schema,
 * same card, different taxonomy — so the two stay visually consistent.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DirectoryCard from '../../components/DirectoryCard.astro';
import DirectoryFilter from '../../components/DirectoryFilter.astro';
import Newsletter from '../../components/Newsletter.astro';
import {
  getAgents,
  groupByCategory,
  categoryFacets,
  slugOfItem,
} from '../../lib/directory';
import { breadcrumbSchema, collectionPageSchema } from '../../lib/schema';
import { SITE } from '../../config/site.config';
import ArticleCTA from '../../components/ArticleCTA.astro';

const agents = await getAgents();
const groups = groupByCategory(agents);
const categories = categoryFacets(agents);

const pricing = [...new Set(agents.map((a) => a.data.pricing))]
  .map((value) => ({
    value,
    count: agents.filter((a) => a.data.pricing === value).length,
  }))
  .sort((a, b) => b.count - a.count);

const path = '/agents';
const title = 'AI Agent Directory';
const description = `A directory of ${agents.length} AI agents and agent frameworks — coding agents, browser agents, research agents and orchestration libraries, with runtime, autonomy level and MCP support for each.`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'AI Agents', href: '/agents/' },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaNodes={[
    collectionPageSchema({
      path,
      title,
      description,
      items: agents.map((a) => ({
        name: a.data.name,
        href: `/agents/${slugOfItem(a)}/`,
      })),
    }),
    breadcrumbSchema(path, crumbs),
  ]}
>
  <div class="aurora">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumb items={crumbs} class="mb-6" />

      <header class="max-w-3xl">
        <p
          class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-primary)]"
        >
          Directory
        </p>
        <h1
          class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-[var(--text)] sm:text-4xl"
        >
          AI <span class="text-gradient">Agent Directory</span>
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">
          Agents that plan, call tools and act on your behalf. Each entry records where
          it runs, how much autonomy it is designed for, and whether it speaks the
          Model Context Protocol — the three things that decide whether it fits your
          stack.
        </p>
      </header>
    </div>
  </div>

  <div class="container-page pb-16">
    <DirectoryFilter
      categories={categories}
      pricing={pricing}
      searchLabel={`Search ${agents.length} AI agents`}
      total={agents.length}
    />

    {
      groups.map((group) => (
        <section data-directory-group class="mb-12 last:mb-0">
          <h2 class="mb-5 text-xl font-extrabold tracking-tight text-[var(--text)]">
            <span
              class="mr-2.5 inline-block h-5 w-1 rounded-full bg-[var(--color-primary)] align-[-2px]"
              aria-hidden="true"
            />
            {group.category}
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((agent) => (
              <DirectoryCard item={agent} base="agents" />
            ))}
          </div>
        </section>
      ))
    }

    <p
      data-directory-empty
      hidden
      class="glass px-6 py-12 text-center text-sm text-[var(--text-muted)]"
    >
      No agents match those filters. Try clearing the search box or widening the category.
    </p>

    {
      agents.length === 0 && (
        <p class="glass px-6 py-12 text-center text-sm text-[var(--text-muted)]">
          The agent directory is being populated.
        </p>
      )
    }
  </div>

  {SITE.features.newsletter && <Newsletter />}

  <ArticleCTA title="AI Agents Directory" path={Astro.url.pathname} class="mt-16" />
</BaseLayout>

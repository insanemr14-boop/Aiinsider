---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config/site.config';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';

const org = SITE.organization;
const email = org.email;

// Assembled from the config so the contact block, the footer and the
// Organization JSON-LD can never disagree with each other.
const addressLine = org.address
  ? [org.address.street, org.address.locality, org.address.region, org.address.postalCode, org.address.countryName]
      .filter(Boolean)
      .join(', ')
  : null;

const faqs = [
  {
    question: 'How quickly will I get a reply?',
    answer:
      'Commercial and general enquiries are answered within 2–4 hours during business hours (Monday to Saturday, 9:00–19:00 IST). Editorial matters such as corrections and tips are triaged within two business days.',
  },
  {
    question: 'Who actually operates this site?',
    answer:
      'It is published and operated by RioCloud Solutions, a technology and digital services company based in Chandigarh, India. The same team handles enquiries sent through this form.',
  },
  {
    question: 'Do you take paid placements or sponsored reviews?',
    answer:
      'No. We do not accept payment in exchange for a directory listing, a rating, or a review outcome. Sponsorship never influences editorial judgement — the reasoning is set out in our editorial policy.',
  },
  {
    question: 'What happens to the details I submit?',
    answer:
      'They are emailed straight to our team so we can reply. We do not sell your details or add you to a marketing list without asking. Full detail is in the privacy policy.',
  },
  {
    question: 'Can you help with a project rather than the site itself?',
    answer:
      'Yes. Alongside publishing, RioCloud Solutions builds and maintains websites, cloud infrastructure and search visibility for clients. Describe what you need in the form and we will tell you honestly whether we are a good fit.',
  },
];

/** Telephone stripped to digits and `+` for a dialable href. */
const telHref = org.telephone ? `tel:${org.telephone.replace(/[^\d+]/g, '')}` : null;
---

<PageLayout
  title="Contact"
  description={`Get in touch with the ${SITE.name} desk — story tips, corrections, AI tool submissions for the directory, and partnership or press enquiries.`}
  lede="Tips, corrections, tool submissions and press — here is how to reach the right desk."
>
  <p>
    Everything reaches one address:
    <a href={`mailto:${email}`}>{email}</a>. Use the subject-line prefixes below and your
    message gets routed to the right desk faster.
  </p>

  <h2>Send us a message</h2>
  <p>
    Prefer a form? This goes to the same inbox and reaches a person, not an autoresponder.
  </p>
  <LeadForm subject="Enquiry from the contact page" class="mt-6" />

  <h2>Contact details</h2>
  <table>
    <tbody>
      <tr>
        <th scope="row">Email</th>
        <td><a href={`mailto:${email}`}>{email}</a></td>
      </tr>
      {
        org.telephone && telHref && (
          <tr>
            <th scope="row">Phone</th>
            <td><a href={telHref}>{org.telephone}</a></td>
          </tr>
        )
      }
      {
        SITE.social.whatsapp && (
          <tr>
            <th scope="row">WhatsApp</th>
            <td>
              <a href={SITE.social.whatsapp} rel="noopener" target="_blank">
                Message us on WhatsApp
              </a>
            </td>
          </tr>
        )
      }
      {
        addressLine && (
          <tr>
            <th scope="row">Address</th>
            <td>{addressLine}</td>
          </tr>
        )
      }
      {
        org.hours && (
          <tr>
            <th scope="row">Hours</th>
            <td>{org.hours}</td>
          </tr>
        )
      }
      {
        org.responseTime && (
          <tr>
            <th scope="row">Typical reply</th>
            <td>{org.responseTime}</td>
          </tr>
        )
      }
      {
        (SITE.social.linkedin || SITE.social.instagram) && (
          <tr>
            <th scope="row">Social</th>
            <td>
              {SITE.social.linkedin && (
                <a href={SITE.social.linkedin} rel="noopener" target="_blank">
                  LinkedIn
                </a>
              )}
              {SITE.social.linkedin && SITE.social.instagram && ' · '}
              {SITE.social.instagram && (
                <a href={SITE.social.instagram} rel="noopener" target="_blank">
                  Instagram
                </a>
              )}
            </td>
          </tr>
        )
      }
    </tbody>
  </table>

  {
    org.operatedBy && (
      <p>
        {SITE.name} is published and operated by <strong>{org.operatedBy}</strong>
        {addressLine ? `, ${addressLine}` : ''}. Commercial and editorial enquiries both go
        to the address above — see the <a href="/disclaimer/">disclaimer</a> for how the two
        are kept separate.
      </p>
    )
  }

  <h2>Story tips and pitches</h2>
  <p>
    Subject line <code>TIP</code>. Model releases, research you think is being under-covered,
    a lab or product story with something behind it, or a build you have shipped that would
    make a good tutorial. Include links to primary sources — a paper, a repo, a changelog, a
    model card. Tips backed by documents get read first.
  </p>
  <p>
    We do not pay for tips, and we will not name you unless you ask to be named.
  </p>

  <h2>Corrections</h2>
  <p>
    Subject line <code>CORRECTION</code>. Include the article URL and the exact claim you
    are disputing, plus a source we can check. Benchmark numbers, pricing tiers and context
    limits move quickly, so we would rather hear about a stale figure than leave it up.
  </p>
  <p>
    Corrections that change a conclusion or a recommendation are noted on the article with
    the date of the change. See the <a href="/editorial-policy/">editorial policy</a> for
    how we handle them.
  </p>

  <h2>Tool and agent submissions</h2>
  <p>
    Subject line <code>DIRECTORY</code>. To be considered for the
    <a href="/tools/">AI tool directory</a> or the
    <a href="/agents/">AI agent directory</a>, send:
  </p>
  <ul>
    <li>Product name, homepage URL and a one-sentence description of what it does.</li>
    <li>The category it belongs in and what it competes with.</li>
    <li>Pricing structure — free tier, individual plan, team, enterprise.</li>
    <li>Docs or API reference, and a way for us to try it without a sales call.</li>
  </ul>
  <p>
    Listings are free and cannot be bought. We do not accept payment for inclusion,
    position or rating, and a submission is not a guarantee of a listing. Prompt
    contributions for the <a href="/prompts/">prompt library</a> use the same address.
  </p>

  <h2>Partnerships and press</h2>
  <p>
    Subject line <code>PARTNER</code> for sponsorship, syndication, licensing or content
    partnerships, and <code>PRESS</code> for interview requests, commentary or analyst
    briefings. Include your deadline. Sponsorship never buys editorial coverage or a
    directory position — the two are handled separately and disclosed where relevant.
  </p>

  <h2>Website and security issues</h2>
  <p>
    Subject line <code>SECURITY</code> for a vulnerability in this site, or
    <code>BUG</code> for anything broken — a dead link, a rendering problem, a bad search
    result. Include the URL and your browser. We do not run a paid bounty, and we will
    credit reporters who want credit.
  </p>

  <h2>What we do not accept</h2>
  <ul>
    <li>Paid guest posts, sponsored articles or link insertions.</li>
    <li>Requests to remove or soften accurate published reporting.</li>
    <li>Unsolicited fully AI-generated article submissions.</li>
    <li>Payment in exchange for a directory listing, a rating or a review outcome.</li>
  </ul>
  <p>
    The reasoning is in the <a href="/editorial-policy/">editorial policy</a> and the
    <a href="/disclaimer/">disclaimer</a>.
  </p>

  <h2>Data and privacy requests</h2>
  <p>
    Subject line <code>PRIVACY</code> for access, correction or deletion requests. What we
    hold and how long we hold it is described in the
    <a href="/privacy-policy/">privacy policy</a>.
  </p>

  <h2>Response times</h2>
  <p>
    Commercial and general enquiries are typically answered within
    {org.responseTime ? ` ${org.responseTime}` : ' one business day'}
    {org.hours ? `, ${org.hours.toLowerCase()}` : ''}. Editorial work runs on a slower
    clock: security reports and corrections are triaged within two business days, and
    tips, pitches and directory submissions may take longer. We read everything and reply
    to anything that needs a reply.
  </p>

  <FAQ items={faqs} class="mt-12" />
</PageLayout>

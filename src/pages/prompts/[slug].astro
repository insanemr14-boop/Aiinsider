---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCTA from '../../components/ArticleCTA.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPrompts, promptUrl, slugOfItem, type Prompt } from '../../lib/directory';
import { breadcrumbSchema, promptSchema, webPageSchema } from '../../lib/schema';
import { SITE } from '../../config/site.config';

export const getStaticPaths = (async () => {
  const prompts = await getPrompts();
  return prompts.map((prompt) => ({
    params: { slug: slugOfItem(prompt) },
    props: {
      prompt,
      // Same-category prompts make the most useful "next" list here — a prompt
      // is chosen by task, not by recency.
      related: prompts
        .filter((p) => p.id !== prompt.id && p.data.category === prompt.data.category)
        .slice(0, 3),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  prompt: Prompt;
  related: Prompt[];
}

const { prompt, related } = Astro.props;
const d = prompt.data;
const { Content } = await render(prompt);

const path = `/prompts/${slugOfItem(prompt)}`;
const title = d.seoTitle ?? `${d.title} — AI Prompt Template`;
const description = d.seoDescription ?? d.description;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Prompt Library', href: '/prompts/' },
  { name: d.title, href: `${path}/` },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={d.tags}
  schemaNodes={[
    webPageSchema({ path, title, description, breadcrumbPath: path }),
    promptSchema({ path, title: d.title, description: d.description, variables: d.variables }),
    breadcrumbSchema(path, crumbs),
  ]}
>
  <div class="aurora">
    <div class="container-page py-10 sm:py-12">
      <Breadcrumb items={crumbs} class="mb-6" />

      <header class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-primary)]">
          {d.category}
        </p>
        <h1
          class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-[var(--text)] sm:text-4xl"
        >
          {d.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">{d.description}</p>
      </header>
    </div>
  </div>

  <div class="container-page pb-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_18rem]">
      <div class="min-w-0">
        <CopyBlock text={d.prompt} label="Prompt template" />

        {
          d.notes && (
            <section class="glass mt-6 p-5">
              <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
                Why this works
              </h2>
              <p class="mt-2.5 leading-relaxed text-[var(--text-muted)]">{d.notes}</p>
            </section>
          )
        }

        {
          d.exampleOutput && (
            <section class="mt-6">
              <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
                Example output
              </h2>
              <CopyBlock text={d.exampleOutput} label="Example" />
            </section>
          )
        }

        <div class="prose mt-8">
          <Content />
        </div>
      </div>

      {/* ---------------- Metadata sidebar ---------------- */}
      <aside class="lg:sticky lg:top-24 lg:self-start">
        {
          d.variables.length > 0 && (
            <div class="glass p-5">
              <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
                Variables to replace
              </h2>
              <ul class="mt-3 space-y-2">
                {d.variables.map((v) => (
                  <li>
                    <code class="rounded bg-[var(--bg-alt)] px-1.5 py-0.5 font-mono text-xs text-[var(--text)]">
                      {`{{${v}}}`}
                    </code>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          d.models.length > 0 && (
            <div class="glass mt-4 p-5">
              <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
                Tested on
              </h2>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {d.models.map((m) => (
                  <li class="rounded-full border border-[var(--border)] px-2.5 py-1 text-xs font-medium text-[var(--text-muted)]">
                    {m}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          d.tags.length > 0 && (
            <div class="glass mt-4 p-5">
              <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
                Tags
              </h2>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {d.tags.map((t) => (
                  <li>
                    <a
                      href={`/tag/${t}/`}
                      class="rounded-full border border-[var(--border)] px-2.5 py-1 text-xs font-medium
                             text-[var(--text-muted)] transition hover:border-[var(--border-strong)]
                             hover:text-[var(--text)]"
                    >
                      #{t}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-14" aria-labelledby="related-prompts">
          <SectionHeading
            id="related-prompts"
            title={`More ${d.category.toLowerCase()} prompts`}
            href="/prompts/"
            linkLabel="Browse library"
          />
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <article class="glass group relative flex flex-col p-5 transition hover:-translate-y-0.5 hover:border-[var(--border-strong)]">
                <h3 class="text-base font-bold leading-snug tracking-tight text-[var(--text)]">
                  <a href={promptUrl(p)} class="after:absolute after:inset-0 hover:text-[var(--color-primary)]">
                    {p.data.title}
                  </a>
                </h3>
                <p class="clamp-3 mt-2.5 text-sm leading-relaxed text-[var(--text-muted)]">
                  {p.data.description}
                </p>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </div>

  {SITE.features.newsletter && <Newsletter />}
  <ArticleCTA title={prompt.data.title} path={`${path}/`} class="mx-auto mt-16 max-w-5xl px-4 sm:px-6" />
</BaseLayout>

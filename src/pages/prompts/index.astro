---
/**
 * Prompt Library index.
 *
 * Prompts are grouped by category and filtered client-side by the same
 * enhancement used on the directory pages. The `data-pricing` attribute the
 * filter expects is set to a constant here so the pricing facet collapses to a
 * single inert option — cheaper than forking the filter component.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPrompts, groupByCategory, categoryFacets, promptUrl } from '../../lib/directory';
import { breadcrumbSchema, collectionPageSchema } from '../../lib/schema';
import { SITE } from '../../config/site.config';
import ArticleCTA from '../../components/ArticleCTA.astro';

const prompts = await getPrompts();
const groups = groupByCategory(prompts);
const categories = categoryFacets(prompts);

const path = '/prompts';
const title = 'AI Prompt Library';
const description = `${prompts.length} production-tested prompts for writing, coding, research, marketing, data analysis and agents — each with its variables, the models it was tested on, and why it works.`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Prompt Library', href: '/prompts/' },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaNodes={[
    collectionPageSchema({
      path,
      title,
      description,
      items: prompts.map((p) => ({ name: p.data.title, href: promptUrl(p) })),
    }),
    breadcrumbSchema(path, crumbs),
  ]}
>
  <div class="aurora">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumb items={crumbs} class="mb-6" />

      <header class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-primary)]">
          Library
        </p>
        <h1
          class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-[var(--text)] sm:text-4xl"
        >
          AI <span class="text-gradient">Prompt Library</span>
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">
          Copy-ready prompts that hold up in real work. Every entry lists the variables
          you need to fill in, the models it has been tested against, and a short note
          on the technique it uses — so you can adapt it rather than just paste it.
        </p>
      </header>
    </div>
  </div>

  <div class="container-page pb-16">
    {/* Category chips. Anchor links rather than JS — the page is short enough
        that jumping to a section beats filtering, and it works everywhere. */}
    <nav aria-label="Prompt categories" class="glass mb-8 flex flex-wrap gap-1.5 p-4">
      {
        categories.map((c) => (
          <a
            href={`#${c.value.toLowerCase().replace(/\s+/g, '-')}`}
            class="rounded-full border border-[var(--border)] px-3 py-1.5 text-xs font-semibold
                   text-[var(--text-muted)] transition hover:border-[var(--border-strong)]
                   hover:text-[var(--text)]"
          >
            {c.value} <span class="opacity-60">{c.count}</span>
          </a>
        ))
      }
    </nav>

    {
      groups.map((group) => (
        <section
          id={group.category.toLowerCase().replace(/\s+/g, '-')}
          class="mb-12 scroll-mt-28 last:mb-0"
        >
          <h2 class="mb-5 text-xl font-extrabold tracking-tight text-[var(--text)]">
            <span
              class="mr-2.5 inline-block h-5 w-1 rounded-full bg-[var(--color-primary)] align-[-2px]"
              aria-hidden="true"
            />
            {group.category}
          </h2>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((prompt) => (
              <article class="glass group relative flex flex-col p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-lg hover:shadow-black/5">
                <h3 class="text-base font-bold leading-snug tracking-tight text-[var(--text)]">
                  <a
                    href={promptUrl(prompt)}
                    class="after:absolute after:inset-0 hover:text-[var(--color-primary)]"
                  >
                    {prompt.data.title}
                  </a>
                </h3>
                <p class="clamp-3 mt-2.5 text-sm leading-relaxed text-[var(--text-muted)]">
                  {prompt.data.description}
                </p>

                <div class="mt-4 flex flex-wrap items-center gap-1.5">
                  {prompt.data.variables.slice(0, 3).map((v) => (
                    <code class="rounded bg-[var(--bg-alt)] px-1.5 py-0.5 font-mono text-[11px] text-[var(--text-subtle)]">
                      {`{{${v}}}`}
                    </code>
                  ))}
                  {prompt.data.variables.length > 3 && (
                    <span class="text-[11px] text-[var(--text-subtle)]">
                      +{prompt.data.variables.length - 3} more
                    </span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    {
      prompts.length === 0 && (
        <p class="glass px-6 py-12 text-center text-sm text-[var(--text-muted)]">
          The prompt library is being populated.
        </p>
      )
    }
  </div>

  {SITE.features.newsletter && <Newsletter />}

  <ArticleCTA title="Prompt Library" path={Astro.url.pathname} class="mt-16" />
</BaseLayout>

---
/**
 * Detail page for a directory entry — shared by /tools/[slug] and
 * /agents/[slug], which use the same schema.
 *
 * One layout rather than two near-identical pages: the only difference between
 * the two directories is the taxonomy and the agent-only attribute row.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Rating from '../components/Rating.astro';
import DirectoryCard from '../components/DirectoryCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Newsletter from '../components/Newsletter.astro';
import ArticleCTA from '../components/ArticleCTA.astro';
import type { DirectoryItem } from '../lib/directory';
import {
  PRICING_LABELS,
  RUNTIME_LABELS,
  AUTONOMY_LABELS,
  slugOfItem,
} from '../lib/directory';
import {
  breadcrumbSchema,
  softwareApplicationSchema,
  webPageSchema,
} from '../lib/schema';
import { SITE } from '../config/site.config';
import { formatDate } from '../lib/articles';

interface Props {
  item: DirectoryItem;
  base: 'tools' | 'agents';
  /** Label for the directory in the breadcrumb, e.g. "AI Tools". */
  baseLabel: string;
  related: DirectoryItem[];
}

const { item, base, baseLabel, related } = Astro.props;
const d = item.data;

const path = `/${base}/${slugOfItem(item)}`;
const title = d.seoTitle ?? `${d.name} — Review, Features and Pricing`;
const description = d.seoDescription ?? d.description;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: baseLabel, href: `/${base}/` },
  { name: d.name, href: `${path}/` },
];

// Agent-only fields. Guarded rather than cast so a schema change is a type
// error here, not `undefined` in the rendered output.
const isAgent = 'runtime' in d;
const runtime = isAgent ? RUNTIME_LABELS[d.runtime] : undefined;
const autonomy = isAgent ? AUTONOMY_LABELS[d.autonomy] : undefined;
const mcp = isAgent ? d.mcpSupport : undefined;

const monogram = d.name
  .replace(/[^A-Za-z0-9 ]/g, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');

/** Key/value rows rendered in the spec panel. Falsy entries are dropped. */
const specs = [
  { label: 'Vendor', value: d.vendor },
  { label: 'Category', value: d.category },
  { label: 'Pricing', value: PRICING_LABELS[d.pricing] },
  { label: 'Price', value: d.priceNote },
  { label: 'Runtime', value: runtime },
  { label: 'Autonomy', value: autonomy },
  { label: 'MCP support', value: mcp === undefined ? undefined : mcp ? 'Yes' : 'No' },
  { label: 'Best for', value: d.bestFor },
].filter((s): s is { label: string; value: string } => Boolean(s.value));
---

<BaseLayout
  title={title}
  description={description}
  type="website"
  schemaNodes={[
    webPageSchema({ path, title, description, breadcrumbPath: path }),
    softwareApplicationSchema({
      path,
      name: d.name,
      description: d.description,
      vendor: d.vendor,
      website: d.website,
      category: d.category,
      pricing: d.pricing,
      rating: d.rating,
      features: d.features,
    }),
    breadcrumbSchema(path, crumbs),
  ]}
>
  <div class="aurora">
    <div class="container-page py-10 sm:py-12">
      <Breadcrumb items={crumbs} class="mb-6" />

      <header class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <span
          class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br
                 from-[var(--color-grad-from)] to-[var(--color-grad-to)] text-xl font-bold
                 text-white shadow-md"
          aria-hidden="true">{monogram}</span>

        <div class="min-w-0 flex-1">
          <h1
            class="text-3xl font-extrabold leading-tight tracking-tight text-[var(--text)] sm:text-4xl"
          >
            {d.name}
          </h1>
          <p class="mt-2 text-lg leading-relaxed text-[var(--text-muted)]">{d.tagline}</p>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
            {d.rating !== undefined && <Rating rating={d.rating} size="md" />}
            <span class="text-sm text-[var(--text-subtle)]">by {d.vendor}</span>
            {
              d.updatedDate && (
                <span class="text-sm text-[var(--text-subtle)]">
                  Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time>
                </span>
              )
            }
          </div>
        </div>

        <div class="flex shrink-0 flex-col gap-2 sm:w-44">
          <a
            href={d.website}
            rel="nofollow noopener external"
            target="_blank"
            class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-[var(--color-primary)]
                   px-4 py-2.5 text-sm font-semibold text-white transition
                   hover:bg-[var(--color-primary-hover)]
                   focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                   focus-visible:outline-[var(--ring)]"
          >
            Visit site
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8"></path>
            </svg>
          </a>
          {
            d.docs && (
              <a
                href={d.docs}
                rel="nofollow noopener external"
                target="_blank"
                class="inline-flex items-center justify-center rounded-lg border border-[var(--border)]
                       px-4 py-2.5 text-sm font-semibold text-[var(--text-muted)] transition
                       hover:border-[var(--border-strong)] hover:text-[var(--text)]"
              >
                Documentation
              </a>
            )
          }
        </div>
      </header>
    </div>
  </div>

  <div class="container-page pb-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_20rem]">
      {/* ---------------- Main column ---------------- */}
      <div class="min-w-0">
        <section class="glass p-6">
          <h2 class="text-lg font-bold tracking-tight text-[var(--text)]">Overview</h2>
          <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{d.description}</p>

          {
            d.features.length > 0 && (
              <>
                <h3 class="mt-6 text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
                  Key capabilities
                </h3>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {d.features.map((f) => (
                    <li class="rounded-full border border-[var(--border)] px-2.5 py-1 text-xs font-medium text-[var(--text-muted)]">
                      {f}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </section>

        {/* ---------------- Pros and cons ---------------- */}
        {
          (d.pros.length > 0 || d.cons.length > 0) && (
            <section class="mt-6 grid gap-4 sm:grid-cols-2">
              {d.pros.length > 0 && (
                <div class="glass p-5">
                  <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-emerald-600 dark:text-emerald-400">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="m4 12 5 5L20 6" />
                    </svg>
                    Strengths
                  </h2>
                  <ul class="mt-3 space-y-2.5">
                    {d.pros.map((p) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-[var(--text-muted)]">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true" />
                        {p}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {d.cons.length > 0 && (
                <div class="glass p-5">
                  <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-rose-600 dark:text-rose-400">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M6 6l12 12M18 6 6 18" />
                    </svg>
                    Limitations
                  </h2>
                  <ul class="mt-3 space-y-2.5">
                    {d.cons.map((c) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-[var(--text-muted)]">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-rose-500" aria-hidden="true" />
                        {c}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )
        }

        {/* ---------------- Editorial body ---------------- */}
        <div class="prose mt-8">
          <slot />
        </div>

        {
          d.relatedArticle && (
            <a
              href={`/articles/${d.relatedArticle}/`}
              class="glass mt-8 flex items-center justify-between gap-4 p-5 transition
                     hover:border-[var(--border-strong)]"
            >
              <span>
                <span class="block text-xs font-bold uppercase tracking-wide text-[var(--color-primary)]">
                  Read next
                </span>
                <span class="mt-1 block font-semibold text-[var(--text)]">
                  Our full write-up on {d.name} and its alternatives
                </span>
              </span>
              <span class="text-[var(--color-primary)]" aria-hidden="true">&rarr;</span>
            </a>
          )
        }
      </div>

      {/* ---------------- Spec sidebar ---------------- */}
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="glass p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text-subtle)]">
            At a glance
          </h2>
          <dl class="mt-4 space-y-3">
            {
              specs.map((spec) => (
                <div class="flex justify-between gap-4 border-b border-[var(--border)] pb-3 last:border-0 last:pb-0">
                  <dt class="shrink-0 text-xs font-semibold text-[var(--text-subtle)]">
                    {spec.label}
                  </dt>
                  <dd class="text-right text-xs font-medium text-[var(--text)]">
                    {spec.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="mt-4 px-1 text-xs leading-relaxed text-[var(--text-subtle)]">
          {SITE.name} takes no payment for directory inclusion or placement. Pricing and
          capabilities change frequently — always confirm on the vendor's own site
          before committing.
        </p>
      </aside>
    </div>

    {/* ---------------- Related entries ---------------- */}
    {
      related.length > 0 && (
        <section class="mt-14" aria-labelledby="related-directory">
          <SectionHeading
            id="related-directory"
            title="Similar options"
            href={`/${base}/`}
            linkLabel="Browse all"
          />
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <DirectoryCard item={r} base={base} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <ArticleCTA title={item.data.title} path={`${path}/`} class="mt-16" />
  </div>

  {SITE.features.newsletter && <Newsletter />}
</BaseLayout>

---
/**
 * The brand mark.
 *
 * A neural-node glyph: three input nodes converging on a central node, with an
 * output edge. Drawn as inline SVG so it costs no request, scales losslessly
 * and inherits the brand gradient from the design tokens.
 *
 * The gradient needs a document-unique id — two instances on one page sharing
 * an id would make the second reference the first's (possibly removed) def.
 */
interface Props {
  class?: string;
  /** Suffix for the gradient id when several logos render on one page. */
  idSuffix?: string;
}

const { class: className = 'size-8', idSuffix = 'nav' } = Astro.props;
const gradientId = `logo-gradient-${idSuffix}`;
---

<svg class={className} viewBox="0 0 32 32" role="img" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#6366F1"></stop>
      <stop offset="55%" stop-color="#8B5CF6"></stop>
      <stop offset="100%" stop-color="#D946EF"></stop>
    </linearGradient>
  </defs>

  <rect width="32" height="32" rx="9" fill={`url(#${gradientId})`}></rect>

  {/* Edges */}
  <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity="0.9">
    <path d="M10 9.5 16.5 16"></path>
    <path d="M10 16h6.5"></path>
    <path d="M10 22.5 16.5 16"></path>
    <path d="M16.5 16H23"></path>
  </g>

  {/* Nodes */}
  <g fill="#fff">
    <circle cx="9.5" cy="9.5" r="2.1"></circle>
    <circle cx="9.5" cy="16" r="2.1"></circle>
    <circle cx="9.5" cy="22.5" r="2.1"></circle>
    <circle cx="23" cy="16" r="2.1"></circle>
  </g>

  <circle cx="16.5" cy="16" r="3" fill="#fff"></circle>
  <circle cx="16.5" cy="16" r="1.3" fill={`url(#${gradientId})`}></circle>
</svg>
